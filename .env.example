# ── GHL Integration ──
GHL_PRIVATE_INTEGRATION_TOKEN=your_token_here
GHL_LOCATION_ID=your_location_id

# ── JustCall Integration ──
JUSTCALL_API_KEY=your_key_here
JUSTCALL_API_SECRET=your_secret_here

# ── Whisper (local transcription) ──
WHISPER_MODEL=base
# Options: tiny, base, small, medium, large

# ── Telegram (for Atlas alerts) ──
TELEGRAM_CHAT_ID=-1003975794600
TELEGRAM_PIPELINE_TOPIC=389
TELEGRAM_DEALROOM_TOPIC=390
TELEGRAM_GENERAL_TOPIC=391

# ── Webhook tunnel (ngrok or Cloudflare) ──
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.app
# Used for GHL + JustCall to POST events back

# ── Server ──
PORT=3000
NODE_ENV=development
