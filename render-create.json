{
  "name": "prolific-ghl-webhook",
  "region": "oregon",
  "repo": "https://github.com/montelli99/prolific-ghl-webhook",
  "branch": "master",
  "plan": "free",
  "runtime": "node",
  "buildCommand": "npm install",
  "startCommand": "npm start",
  "envVars": [
    {"key": "DATABASE_URL", "sync": false},
    {"key": "PORT", "value": "3000"},
    {"key": "NODE_ENV", "value": "production"},
    {"key": "TELNYX_KEY", "sync": false},
    {"key": "ELEVENLABS_KEY", "sync": false},
    {"key": "GHL_API_KEY", "sync": false},
    {"key": "JUSTCALL_AUTH", "sync": false}
  ]
}
